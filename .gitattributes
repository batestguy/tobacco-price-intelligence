# Normalise to LF in the repository. Authoring happens on Windows but every job
# runs on a Linux Actions runner; without this, the commit-back step would see
# spurious line-ending diffs on files it never touched.
* text=auto eol=lf

# Binary artifacts -- never diff or line-ending-convert these.
*.parquet binary
*.joblib  binary
*.png     binary
*.jpg     binary
*.xlsx    binary

# Notebooks are JSON: keep them out of diffs to stop review noise.
*.ipynb -diff
